<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="sample.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Agile.Maui;assembly=Agile.Maui"
    xmlns:local="clr-namespace:sample"
    Title="ImageView Demo">

    <ContentPage.BindingContext>
        <local:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16,24" Spacing="0">

            <!--  Cabeçalho  -->
            <Label
                Margin="0,0,0,4"
                Style="{StaticResource Headline}"
                Text="ImageView" />

            <Label
                Margin="0,0,0,24"
                FontSize="13"
                HorizontalTextAlignment="Center"
                Text="Toque em qualquer imagem para abrir em fullscreen com zoom"
                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                            Dark={StaticResource Gray400}}" />

            <!--  ── 1. URL · CenterCrop ────────────────────────────────  -->
            <Label
                Margin="2,0,0,6"
                FontAttributes="Bold"
                FontSize="12"
                Text="URL · CenterCrop · MaxZoom 6×"
                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                            Dark={StaticResource Gray400}}" />

            <controls:ImageView
                AspectMode="CenterCrop"
                EnableFullscreen="True"
                HeightRequest="220"
                ImageFailedCommand="{Binding ImageFailedCommand}"
                ImageLoadedCommand="{Binding ImageLoadedCommand}"
                IsUrl="True"
                MaxZoom="6"
                Placeholder="dotnet_bot"
                Source="https://picsum.photos/seed/maui1/800/500" />

            <!--  ── 2. URL · AspectFit ─────────────────────────────────  -->
            <Label
                Margin="2,20,0,6"
                FontAttributes="Bold"
                FontSize="12"
                Text="URL · AspectFit · MaxZoom 8×"
                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                            Dark={StaticResource Gray400}}" />

            <controls:ImageView
                AspectMode="AspectFit"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                                  Dark={StaticResource Gray950}}"
                EnableFullscreen="True"
                HeightRequest="220"
                ImageFailedCommand="{Binding ImageFailedCommand}"
                ImageLoadedCommand="{Binding ImageLoadedCommand}"
                IsUrl="True"
                MaxZoom="8"
                Placeholder="dotnet_bot"
                Source="https://picsum.photos/seed/maui2/400/700" />

            <!--  ══ GalleryView ══════════════════════════════════════  -->
            <Label
                Margin="0,32,0,4"
                Style="{StaticResource Headline}"
                Text="GalleryView" />

            <Label
                Margin="0,0,0,24"
                FontSize="13"
                HorizontalTextAlignment="Center"
                Text="Toque na galeria para navegar entre imagens em fullscreen com zoom e swipe"
                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                            Dark={StaticResource Gray400}}" />

            <!--  ── 5. Galeria de URLs ────────────────────────────────  -->
            <Label
                Margin="2,0,0,6"
                FontAttributes="Bold"
                FontSize="12"
                Text="Galeria · URLs · CenterCrop · MaxZoom 6×"
                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                            Dark={StaticResource Gray400}}" />

            <controls:GalleryView
                AspectMode="CenterCrop"
                HeightRequest="220"
                ImageFailedCommand="{Binding GalleryImageFailedCommand}"
                ImageLoadedCommand="{Binding GalleryImageLoadedCommand}"
                Images="{Binding UrlImages}"
                IsUrl="True"
                MaxZoom="6"
                Placeholder="dotnet_bot"
                SelectedIndex="{Binding UrlSelectedIndex, Mode=TwoWay}"
                SelectionChangedCommand="{Binding UrlSelectionChangedCommand}"
                ShowIndicator="True" />




        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
