<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="sample.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gallery="clr-namespace:Agile.Maui;assembly=Agile.Maui.Gallery"
    xmlns:local="clr-namespace:sample"
    Title="Gallery View"
    BackgroundColor="{StaticResource BackdropLight}">

    <ContentPage.BindingContext>
        <local:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="28,32" Spacing="0">

            <Label
                Margin="0,0,0,4"
                Style="{StaticResource Headline}"
                Text="ImageView" />

            <Label
                Margin="0,0,0,24"
                FontSize="13"
                Text="Tap any image to open fullscreen zoom."
                TextColor="{StaticResource OnSurfaceVariantLight}" />

            <Label
                Margin="2,0,0,6"
                FontAttributes="Bold"
                FontSize="12"
                Text="URL · CenterCrop · MaxZoom 6x"
                TextColor="{StaticResource OnSurfaceVariantLight}" />

            <gallery:ImageView
                AspectMode="CenterCrop"
                EnableFullscreen="True"
                HeightRequest="220"
                ImageFailedCommand="{Binding ImageFailedCommand}"
                ImageLoadedCommand="{Binding ImageLoadedCommand}"
                IsUrl="True"
                MaxZoom="6"
                Placeholder="dotnet_bot"
                Source="https://picsum.photos/seed/maui1/800/500" />

            <Label
                Margin="2,20,0,6"
                FontAttributes="Bold"
                FontSize="12"
                Text="URL · AspectFit · MaxZoom 8x"
                TextColor="{StaticResource OnSurfaceVariantLight}" />

            <gallery:ImageView
                AspectMode="AspectFit"
                BackgroundColor="{StaticResource Gray100}"
                EnableFullscreen="True"
                HeightRequest="220"
                ImageFailedCommand="{Binding ImageFailedCommand}"
                ImageLoadedCommand="{Binding ImageLoadedCommand}"
                IsUrl="True"
                MaxZoom="8"
                Placeholder="dotnet_bot"
                Source="https://picsum.photos/seed/maui2/400/700" />

            <Label
                Margin="0,32,0,4"
                Style="{StaticResource Headline}"
                Text="GalleryView" />

            <Label
                Margin="0,0,0,24"
                FontSize="13"
                Text="Tap the gallery to browse fullscreen images with zoom and swipe."
                TextColor="{StaticResource OnSurfaceVariantLight}" />

            <Label
                Margin="2,0,0,6"
                FontAttributes="Bold"
                FontSize="12"
                Text="Gallery · URLs · CenterCrop · MaxZoom 6x"
                TextColor="{StaticResource OnSurfaceVariantLight}" />

            <gallery:GalleryView
                AspectMode="CenterCrop"
                HeightRequest="220"
                ImageFailedCommand="{Binding GalleryImageFailedCommand}"
                ImageLoadedCommand="{Binding GalleryImageLoadedCommand}"
                Images="{Binding UrlImages}"
                IsUrl="True"
                MaxZoom="6"
                Placeholder="dotnet_bot"
                SelectedIndex="{Binding UrlSelectedIndex, Mode=TwoWay}"
                SelectionChangedCommand="{Binding UrlSelectionChangedCommand}"
                ShowIndicator="True" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
