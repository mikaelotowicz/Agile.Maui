<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.26100.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>sample</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Agile</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.sample</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup>
		<_DisableIOSSimulatorDebugReadyToRun Condition="'$(TargetFramework)' == 'net11.0-ios' and '$(Configuration)' == 'Debug'">true</_DisableIOSSimulatorDebugReadyToRun>
	</PropertyGroup>

	<PropertyGroup Condition="'$(_DisableIOSSimulatorDebugReadyToRun)' == 'true'">
		<!-- Avoid iOS Simulator/CoreCLR startup crash while opening sample.r2r.framework. -->
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishReadyToRunComposite>false</PublishReadyToRunComposite>
		<CreateR2RFramework>false</CreateR2RFramework>
		<CreateR2RDylib>false</CreateR2RDylib>
	</PropertyGroup>

	<Target Name="_DisableIOSDebugReadyToRun"
		BeforeTargets="ResolveReadyToRunCompilers;_PrepareForReadyToRunCompilation;CreateReadyToRunImages"
		Condition="'$(_DisableIOSSimulatorDebugReadyToRun)' == 'true'">
		<PropertyGroup>
			<PublishReadyToRun>false</PublishReadyToRun>
			<PublishReadyToRunComposite>false</PublishReadyToRunComposite>
			<CreateR2RFramework>false</CreateR2RFramework>
			<CreateR2RDylib>false</CreateR2RDylib>
		</PropertyGroup>
	</Target>

	<Target Name="_RemoveIOSDebugReadyToRunArtifacts"
		BeforeTargets="_ComputePublishLocation;_CollectR2RFrameworksForPostProcessing"
		DependsOnTargets="_ComputeVariables"
		Condition="'$(_DisableIOSSimulatorDebugReadyToRun)' == 'true'">
		<ItemGroup>
			<_IOSDebugR2RDirectory Include="$(IntermediateOutputPath)R2R" />
			<_IOSDebugR2RDirectory Include="$(IntermediateOutputPath)r2rframework" />
			<_IOSDebugR2RDirectory Include="$(AppBundleDir)$(_AppFrameworksRelativePath)$(AssemblyName).r2r.framework" Condition="'$(AppBundleDir)' != ''" />
			<_IOSDebugR2RDirectory Include="$(OutputPath)$(AssemblyName).app\$(_AppFrameworksRelativePath)$(AssemblyName).r2r.framework" />
			<_IOSDebugR2RDirectory Include="$(OutputPath)$(AssemblyName).app\Frameworks\$(AssemblyName).r2r.framework" />
			<_IOSDebugR2RFile Include="$(IntermediateOutputPath)r2r-input.hash" />
			<_IOSDebugR2RFile Include="$(IntermediateOutputPath)r2r-input.hash.trigger" />
		</ItemGroup>
		<RemoveDir Directories="@(_IOSDebugR2RDirectory)" Condition="Exists('%(_IOSDebugR2RDirectory.Identity)')" />
		<Delete Files="@(_IOSDebugR2RFile)" Condition="Exists('%(_IOSDebugR2RFile.Identity)')" />
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="1024,1024" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<!-- PDFs NÃO são imagens: exclui qualquer .pdf do MauiImage (nomes com hífen/espaço
		     quebram o Resizetizer). Soltar um .pdf em Resources/Images não deve quebrar o build. -->
		<MauiImage Remove="Resources\Images\*.pdf" />
		<!-- PDF de exemplo empacotado (não é imagem): remove do MauiImage e inclui como asset bruto -->
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Tabela de glyphs do Material Design Icons: é código C#, não uma fonte embarcada -->
		<MauiFont Remove="Resources\Fonts\MaterialDesingIconsFonts.cs" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Images\InteligenciaArtificial.pdf" />
	</ItemGroup>

	<ItemGroup>
	  <!-- LogicalName sem o prefixo do diretório → abre por "InteligenciaArtificial.pdf" no OpenAppPackageFileAsync -->
	  <MauiAsset Include="Resources\Images\InteligenciaArtificial.pdf" LogicalName="InteligenciaArtificial.pdf" />
	</ItemGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.0'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-preview.5.26304.4" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-preview.5.26302.115" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GalleryView\GalleryView.csproj" />
		<ProjectReference Include="..\PDFViewer\PDFViewer.csproj" />
		<ProjectReference Include="..\VirtualizedCollectionView\VirtualizedCollectionView.csproj" />
		<ProjectReference Include="..\ChipGroup\ChipGroup.csproj" />
		<ProjectReference Include="..\SignaturePad\SignaturePad.csproj" />
	</ItemGroup>

</Project>
