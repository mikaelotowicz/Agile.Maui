<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="sample.SignaturePadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sign="clr-namespace:Agile.Maui;assembly=Agile.Maui.SignaturePad"
    Title="SignaturePad"
    BackgroundColor="#F2F2F2">

    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="20">

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Sign in the box"
                TextColor="#8B8B8B" />

            <Label
                FontSize="14"
                Text="Variable-width ink based on velocity and pressure (stylus, Apple Pencil, or pen)."
                TextColor="#111111" />

            <Border
                Padding="0"
                BackgroundColor="White"
                HeightRequest="260"
                StrokeThickness="1"
                Stroke="#DDDDDD">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <sign:SignaturePad
                    x:Name="Pad"
                    BackgroundColor="White"
                    MaxStrokeWidth="3.5"
                    MinStrokeWidth="1"
                    PromptText="Sign here"
                    ShowSignatureLine="True"
                    StrokeColor="#1A1A2E"
                    StrokeCompleted="OnStrokeCompleted" />
            </Border>

            <FlexLayout
                Wrap="Wrap"
                JustifyContent="Start"
                AlignItems="Center">
                <Button
                    Margin="0,0,10,10"
                    Clicked="OnClear"
                    Text="Clear" />
                <Button
                    Margin="0,0,10,10"
                    Clicked="OnUndo"
                    Text="Undo" />
                <Button
                    Margin="0,0,10,10"
                    Clicked="OnRedo"
                    Text="Redo" />
                <Button
                    Margin="0,0,10,10"
                    Clicked="OnExport"
                    Text="Export PNG" />
            </FlexLayout>

            <Label
                x:Name="StatsLabel"
                FontSize="13"
                Text="No strokes yet."
                TextColor="#555555" />

            <Label
                FontAttributes="Bold"
                FontSize="15"
                Text="Export preview (cropped transparent PNG):"
                TextColor="#111111" />

            <Border
                Padding="8"
                BackgroundColor="#E9E9F0"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Image
                    x:Name="Preview"
                    Aspect="AspectFit"
                    HeightRequest="160"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
