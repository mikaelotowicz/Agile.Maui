<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:sample"
    Title="Agile"
    BackgroundColor="{StaticResource SurfaceLight}"
    FlyoutBackgroundColor="{StaticResource SurfaceLight}"
    FlyoutBehavior="Flyout"
    ForegroundColor="{StaticResource White}"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.DisabledColor="{StaticResource Gray300}"
    Shell.FlyoutBackgroundColor="{StaticResource SurfaceLight}"
    Shell.ForegroundColor="{StaticResource White}"
    Shell.TitleColor="{StaticResource White}"
    Shell.UnselectedColor="{StaticResource OnSurfaceVariantLight}">

    <Shell.FlyoutHeader>
        <Grid
            Padding="20,28,20,22"
            BackgroundColor="{StaticResource Primary}"
            RowDefinitions="Auto,Auto,Auto">

            <Border
                Padding="12"
                BackgroundColor="{StaticResource SurfaceLight}"
                HeightRequest="96"
                HorizontalOptions="Start"
                StrokeThickness="0"
                WidthRequest="96">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <Image Aspect="AspectFit" Source="agile.png" />
            </Border>

            <Label
                Grid.Row="1"
                Margin="0,14,0,2"
                FontAttributes="Bold"
                FontSize="20"
                Text="Agile.Maui"
                TextColor="{StaticResource White}" />

            <Label
                Grid.Row="2"
                FontSize="13"
                Text="Sample"
                TextColor="{StaticResource Secondary}" />
        </Grid>
    </Shell.FlyoutHeader>

    <!--  Cada ShellContent vira um item do menu (flyout). O PdfViewer é um deles.  -->

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid
                Padding="20,12"
                BackgroundColor="{StaticResource SurfaceLight}"
                ColumnDefinitions="28,*"
                ColumnSpacing="12">
                <Image
                    Grid.Column="0"
                    HeightRequest="22"
                    Source="{Binding FlyoutIcon}"
                    VerticalOptions="Center"
                    WidthRequest="22" />
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    Text="{Binding Title}"
                    TextColor="{StaticResource OnSurfaceLight}"
                    VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <ShellContent
        Title="Gallery View"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuHome}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="PDF Viewer"
        ContentTemplate="{DataTemplate local:ReaderDemoPage}"
        Route="ReaderDemoPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuPdf}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="Virtualized Collection"
        ContentTemplate="{DataTemplate local:VirtualizedListPage}"
        Route="VirtualizedListPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuList}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="Collection Benchmark"
        ContentTemplate="{DataTemplate local:CollectionBenchmarkPage}"
        Route="CollectionBenchmarkPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuList}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="ChipGroup"
        ContentTemplate="{DataTemplate local:ChipGroupPage}"
        Route="ChipGroupPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuChips}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="SignaturePad"
        ContentTemplate="{DataTemplate local:SignaturePadPage}"
        Route="SignaturePadPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuSignature}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

</Shell>
