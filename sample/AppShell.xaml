<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:sample"
    Title="Agile"
    BackgroundColor="{StaticResource SurfaceLight}"
    FlyoutBackgroundColor="{StaticResource SurfaceLight}"
    FlyoutBackdrop="#5C140A33"
    FlyoutBehavior="Flyout"
    FlyoutWidth="300"
    ForegroundColor="{StaticResource White}"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.DisabledColor="{StaticResource Gray300}"
    Shell.FlyoutBackgroundColor="{StaticResource SurfaceLight}"
    Shell.ForegroundColor="{StaticResource White}"
    Shell.TitleColor="{StaticResource White}"
    Shell.UnselectedColor="{StaticResource OnSurfaceVariantLight}">

    <!--
        Menu: cabeçalho em gradiente violeta com detalhes translúcidos, itens em pílula com ícone num
        quadrado lavanda e estado "Selected" destacado; rodapé discreto. Cores locais ao menu para não
        mexer na paleta global do sample.
    -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="14,14,14,0" Spacing="18">
            <Border
                HeightRequest="176"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                        <GradientStop Offset="0" Color="#3A1C9E" />
                        <GradientStop Offset="0.55" Color="#512BD4" />
                        <GradientStop Offset="1" Color="#8A6CF2" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!--  Círculos decorativos  -->
                    <Ellipse
                        Margin="0,-70,-60,0"
                        Fill="#1FFFFFFF"
                        HeightRequest="190"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        WidthRequest="190" />
                    <Ellipse
                        Margin="0,0,40,-50"
                        Fill="#14FFFFFF"
                        HeightRequest="110"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        WidthRequest="110" />

                    <Grid
                        Padding="18"
                        RowDefinitions="*,Auto,Auto"
                        RowSpacing="2">
                        <Border
                            Padding="9"
                            BackgroundColor="{StaticResource White}"
                            HeightRequest="58"
                            HorizontalOptions="Start"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            WidthRequest="58">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#2B0B98"
                                    Opacity="0.35"
                                    Radius="14"
                                    Offset="0,6" />
                            </Border.Shadow>
                            <Image Aspect="AspectFit" Source="agile.png" />
                        </Border>

                        <Border
                            Padding="10,3"
                            BackgroundColor="#29FFFFFF"
                            HorizontalOptions="End"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                CharacterSpacing="1.5"
                                FontFamily="OpenSansSemibold"
                                FontSize="10"
                                Text="SAMPLE"
                                TextColor="{StaticResource White}" />
                        </Border>

                        <Label
                            Grid.Row="1"
                            FontFamily="OpenSansSemibold"
                            FontSize="21"
                            Text="Agile.Maui"
                            TextColor="{StaticResource White}" />
                        <Label
                            Grid.Row="2"
                            FontSize="12.5"
                            Opacity="0.82"
                            Text="Componentes nativos para .NET MAUI"
                            TextColor="{StaticResource White}" />
                    </Grid>
                </Grid>
            </Border>

            <Label
                Margin="8,0,0,2"
                CharacterSpacing="1.6"
                FontFamily="OpenSansSemibold"
                FontSize="11"
                Text="COMPONENTES"
                TextColor="#9A93B3" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!--  Cada ShellContent vira um item do menu (flyout). O PdfViewer é um deles.  -->

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="12,3">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter TargetName="Pill" Property="Border.BackgroundColor" Value="#F1ECFF" />
                                    <Setter TargetName="IconTile" Property="Border.BackgroundColor" Value="{StaticResource White}" />
                                    <Setter TargetName="ItemIcon" Property="Label.TextColor" Value="{StaticResource Primary}" />
                                    <Setter TargetName="ItemTitle" Property="Label.TextColor" Value="{StaticResource Primary}" />
                                    <Setter TargetName="ItemTitle" Property="Label.FontFamily" Value="OpenSansSemibold" />
                                    <Setter TargetName="Marker" Property="BoxView.IsVisible" Value="True" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

                <Border
                    x:Name="Pill"
                    Padding="10,8"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
                        <Border
                            x:Name="IconTile"
                            BackgroundColor="#F5F3FA"
                            HeightRequest="36"
                            StrokeThickness="0"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="11" />
                            </Border.StrokeShape>
                            <!--  Glifo da fonte de ícones (lido do FontImageSource do item) para mudar de cor no estado Selected  -->
                            <Label
                                x:Name="ItemIcon"
                                FontFamily="{Binding FlyoutIcon.FontFamily}"
                                FontSize="19"
                                HorizontalOptions="Center"
                                Text="{Binding FlyoutIcon.Glyph}"
                                TextColor="#6B6385"
                                VerticalOptions="Center" />
                        </Border>
                        <Label
                            x:Name="ItemTitle"
                            Grid.Column="1"
                            FontSize="14.5"
                            Text="{Binding Title}"
                            TextColor="#2A2540"
                            VerticalOptions="Center" />
                        <BoxView
                            x:Name="Marker"
                            Grid.Column="2"
                            CornerRadius="3"
                            HeightRequest="6"
                            IsVisible="False"
                            VerticalOptions="Center"
                            WidthRequest="6"
                            Color="{StaticResource Primary}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="24,12,24,22" Spacing="10">
            <BoxView
                HeightRequest="1"
                Opacity="0.7"
                Color="{StaticResource OutlineLight}" />
            <HorizontalStackLayout Spacing="8">
                <BoxView
                    CornerRadius="4"
                    HeightRequest="8"
                    VerticalOptions="Center"
                    WidthRequest="8"
                    Color="#8A6CF2" />
                <Label
                    FontSize="11.5"
                    Text="Android · iOS · Mac · Windows"
                    TextColor="#9A93B3"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <ShellContent
        Title="Gallery View"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuHome}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="PDF Viewer"
        ContentTemplate="{DataTemplate local:ReaderDemoPage}"
        Route="ReaderDemoPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuPdf}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="Virtualized Collection"
        ContentTemplate="{DataTemplate local:VirtualizedListPage}"
        Route="VirtualizedListPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuList}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="Collection Benchmark"
        ContentTemplate="{DataTemplate local:CollectionBenchmarkPage}"
        Route="CollectionBenchmarkPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuList}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="ChipGroup"
        ContentTemplate="{DataTemplate local:ChipGroupPage}"
        Route="ChipGroupPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuChips}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="SignaturePad"
        ContentTemplate="{DataTemplate local:SignaturePadPage}"
        Route="SignaturePadPage">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{x:Static local:Icons.FontFamily}"
                Glyph="{x:Static local:Icons.MenuSignature}"
                Color="{StaticResource OnSurfaceLight}" />
        </ShellContent.Icon>
    </ShellContent>

</Shell>
