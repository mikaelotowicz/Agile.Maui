<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="sample.PdfViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pdf="clr-namespace:Agile.Maui;assembly=Agile.Maui.Pdf"
    xmlns:local="clr-namespace:sample"
    Title="PDF Viewer"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!--  Estilos de botões  -->
        <Style x:Key="IconBtn" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Aspect" Value="Center" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="WidthRequest" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>

        <Style x:Key="NavBtn" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Aspect" Value="Center" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="WidthRequest" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.3" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="ToolBtn" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Aspect" Value="Center" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="WidthRequest" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="FloatToolBtn" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Aspect" Value="Center" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="HeightRequest" Value="38" />
            <Setter Property="WidthRequest" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

    </ContentPage.Resources>

    <Grid
        BackgroundColor="{StaticResource BackdropLight}"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="0">

        <!--  ── NavBar personalizada (substitui a do Shell) ─────────────────  -->
        <Grid
            x:Name="NavBar"
            Grid.Row="0"
            Padding="2,0,4,0"
            BackgroundColor="{StaticResource SurfaceLight}"
            ColumnDefinitions="Auto,*,Auto"
            HeightRequest="56">

            <!--  Esquerda: abrir menu lateral (flyout)  -->
            <ImageButton
                Grid.Column="0"
                Clicked="OnFlyoutClicked"
                Style="{StaticResource IconBtn}">
                <ImageButton.Source>
                    <FontImageSource
                        FontFamily="{x:Static local:Icons.FontFamily}"
                        Glyph="{x:Static local:Icons.Hamburger}"
                        Size="24"
                        Color="{StaticResource IconLight}" />
                </ImageButton.Source>
            </ImageButton>

            <!--  Centro: título (nome do arquivo + stats)  -->
            <VerticalStackLayout
                Grid.Column="1"
                Padding="6,0"
                Spacing="0"
                VerticalOptions="Center">
                <Label
                    x:Name="FileNameLabel"
                    FontAttributes="Bold"
                    FontSize="15"
                    LineBreakMode="TailTruncation"
                    Text="PdfViewer"
                    TextColor="{StaticResource OnSurfaceLight}" />
                <Label
                    x:Name="StatsLabel"
                    FontSize="10.5"
                    LineBreakMode="TailTruncation"
                    Text="Nenhum documento aberto"
                    TextColor="{StaticResource OnSurfaceVariantLight}" />
            </VerticalStackLayout>

            <!--  Direita: busca + ações (imprimir, compartilhar, menu ⋮)  -->
            <HorizontalStackLayout
                Grid.Column="2"
                Spacing="0"
                VerticalOptions="Center">

                <ImageButton
                    x:Name="SearchToggleBtn"
                    Clicked="OnSearchToggleClicked"
                    Style="{StaticResource IconBtn}">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="{x:Static local:Icons.FontFamily}"
                            Glyph="{x:Static local:Icons.Search}"
                            Size="22"
                            Color="{StaticResource IconLight}" />
                    </ImageButton.Source>
                </ImageButton>

                <ImageButton Clicked="OnPrintClicked" Style="{StaticResource IconBtn}">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="{x:Static local:Icons.FontFamily}"
                            Glyph="{x:Static local:Icons.Print}"
                            Size="22"
                            Color="{StaticResource IconLight}" />
                    </ImageButton.Source>
                </ImageButton>
                <ImageButton Clicked="OnShareClicked" Style="{StaticResource IconBtn}">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="{x:Static local:Icons.FontFamily}"
                            Glyph="{x:Static local:Icons.Share}"
                            Size="22"
                            Color="{StaticResource IconLight}" />
                    </ImageButton.Source>
                </ImageButton>
                <ImageButton
                    x:Name="OrientationButton"
                    Clicked="OnOrientationClicked"
                    Style="{StaticResource IconBtn}">
                    <ImageButton.Source>
                        <FontImageSource
                            x:Name="OrientationIcon"
                            FontFamily="{x:Static local:Icons.FontFamily}"
                            Glyph="{x:Static local:Icons.ScrollH}"
                            Size="22"
                            Color="{StaticResource IconLight}" />
                    </ImageButton.Source>
                </ImageButton>
            </HorizontalStackLayout>

            <!--
                Busca: overlay que cobre a navbar. Desktop: expande parcial (à direita).
                Celular: ocupa a navbar inteira ao abrir. WidthRequest é animada no code-behind.
            -->
            <Border
                x:Name="SearchBar"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Padding="10,0,4,0"
                BackgroundColor="{StaticResource SurfaceLight}"
                HorizontalOptions="End"
                StrokeThickness="0"
                VerticalOptions="Fill"
                WidthRequest="0">
                <Grid
                    ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="0"
                    VerticalOptions="Center">
                    <Entry
                        x:Name="SearchEntry"
                        Grid.Column="0"
                        Completed="OnSearchCompleted"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Placeholder="Buscar"
                        PlaceholderColor="{StaticResource OnSurfaceVariantLight}"
                        ReturnType="Search"
                        TextChanged="OnSearchTextChanged"
                        TextColor="{StaticResource OnSurfaceLight}"
                        Unfocused="OnSearchEntryUnfocused"
                        VerticalOptions="Center" />
                    <BoxView
                        Grid.Column="1"
                        Margin="6,0"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        WidthRequest="1"
                        Color="{StaticResource OutlineLight}" />
                    <Label
                        x:Name="SearchCountLabel"
                        Grid.Column="2"
                        FontSize="11"
                        HorizontalTextAlignment="Center"
                        MinimumWidthRequest="38"
                        Text=""
                        TextColor="{StaticResource OnSurfaceVariantLight}"
                        VerticalOptions="Center" />
                    <ImageButton
                        x:Name="SearchPrevBtn"
                        Grid.Column="3"
                        Clicked="OnSearchPrevClicked"
                        IsEnabled="False"
                        Style="{StaticResource NavBtn}">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="{x:Static local:Icons.FontFamily}"
                                Glyph="{x:Static local:Icons.SearchUp}"
                                Size="18"
                                Color="{StaticResource IconLight}" />
                        </ImageButton.Source>
                    </ImageButton>
                    <ImageButton
                        x:Name="SearchNextBtn"
                        Grid.Column="4"
                        Clicked="OnSearchNextClicked"
                        IsEnabled="False"
                        Style="{StaticResource NavBtn}">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="{x:Static local:Icons.FontFamily}"
                                Glyph="{x:Static local:Icons.SearchDown}"
                                Size="18"
                                Color="{StaticResource IconLight}" />
                        </ImageButton.Source>
                    </ImageButton>
                    <ImageButton
                        x:Name="SearchCloseBtn"
                        Grid.Column="5"
                        Clicked="OnSearchCloseClicked"
                        Style="{StaticResource NavBtn}">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="{x:Static local:Icons.FontFamily}"
                                Glyph="{x:Static local:Icons.Close}"
                                Size="17"
                                Color="{StaticResource IconLight}" />
                        </ImageButton.Source>
                    </ImageButton>
                </Grid>
            </Border>

            <!--  Divisória inferior da navbar  -->
            <BoxView
                Grid.ColumnSpan="3"
                HeightRequest="1"
                VerticalOptions="End"
                Color="{StaticResource OutlineLight}" />
        </Grid>

        <!--  ── Viewer + overlays + controles flutuantes ───────────────────  -->
        <Grid Grid.Row="1">

            <pdf:PdfViewer
                x:Name="Viewer"
                CopiedMessageText="Copiado"
                CopyButtonText="Copiar"
                DocumentLoadFailed="OnDocumentLoadFailed"
                DocumentLoaded="OnDocumentLoaded"
                EnableThumbnailBar="True"
                IsPinchZoomEnabled="True"
                MaxCacheMB="350"
                MaxZoom="3"
                MinZoom="1"
                PageBackgroundColor="White"
                PageChanged="OnPageChanged"
                PageSpacing="8"
                PrefetchAbove="2"
                PrefetchBelow="3"
                PrintJobName="Documento"
                RenderScale="2"
                ThumbnailBarPlacement="Right"
                ThumbnailBarTitleText="Páginas"
                ZoomFactor="1" />

            <!--
                Overlay invisível para fechar a busca: ativo SÓ quando a barra está aberta e vazia.
                Tocar no documento recolhe a barra. Sem view nativa consumindo o toque, o tap dispara
                de forma confiável em todas as plataformas — inclusive no Android, onde tocar fora de
                um Entry NÃO remove o foco sozinho (logo o Unfocused do Entry não dispara).
            -->
            <Grid
                x:Name="SearchDismissOverlay"
                BackgroundColor="Transparent"
                IsVisible="False">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSearchDismissTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!--  Toolbar flutuante de ferramentas (direita)  -->
            <Border
                Margin="0,0,14,0"
                Padding="4"
                BackgroundColor="{StaticResource SurfaceLight}"
                HorizontalOptions="End"
                IsVisible="{OnPlatform Default=False,
                                       WinUI=True}"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.22"
                        Radius="14"
                        Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="2">

                    <ImageButton Clicked="OnZoomInClicked" Style="{StaticResource FloatToolBtn}">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="{x:Static local:Icons.FontFamily}"
                                Glyph="{x:Static local:Icons.ZoomIn}"
                                Size="22"
                                Color="{StaticResource IconLight}" />
                        </ImageButton.Source>
                    </ImageButton>

                    <ImageButton Clicked="OnZoomOutClicked" Style="{StaticResource FloatToolBtn}">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="{x:Static local:Icons.FontFamily}"
                                Glyph="{x:Static local:Icons.ZoomOut}"
                                Size="22"
                                Color="{StaticResource IconLight}" />
                        </ImageButton.Source>
                    </ImageButton>

                    <BoxView
                        Margin="6,2"
                        HeightRequest="1"
                        Color="{StaticResource OutlineLight}" />

                    <ImageButton Clicked="OnResetZoomClicked" Style="{StaticResource FloatToolBtn}">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="{x:Static local:Icons.FontFamily}"
                                Glyph="{x:Static local:Icons.Fit}"
                                Size="22"
                                Color="{StaticResource IconLight}" />
                        </ImageButton.Source>
                    </ImageButton>

                </VerticalStackLayout>
            </Border>

            <!--  Overlay: loading / estado vazio  -->
            <Grid x:Name="LoadingOverlay" BackgroundColor="{StaticResource BackdropLight}">
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="18"
                    VerticalOptions="Center">
                    <ActivityIndicator
                        x:Name="LoadingSpinner"
                        HeightRequest="40"
                        IsRunning="True"
                        IsVisible="True"
                        WidthRequest="40"
                        Color="{StaticResource Accent}" />
                    <Label
                        x:Name="LoadingLabel"
                        FontSize="14.5"
                        HorizontalTextAlignment="Center"
                        Text="Carregando…"
                        TextColor="{StaticResource OnSurfaceVariantLight}" />
                </VerticalStackLayout>
            </Grid>

        </Grid>

        <!--  ── Bottom bar (largura total, estilo leitor) ──────────────────  -->
        <Grid
            Grid.Row="2"
            Padding="8,0"
            BackgroundColor="{StaticResource SurfaceLight}"
            ColumnDefinitions="Auto,*,Auto"
            HeightRequest="48">

            <BoxView
                Grid.ColumnSpan="3"
                HeightRequest="1"
                VerticalOptions="Start"
                Color="{StaticResource OutlineLight}" />

            <!--  Esquerda: miniaturas. Desktop alterna a sidebar fixa; mobile abre o drawer.  -->
            <HorizontalStackLayout
                Grid.Column="0"
                Spacing="2"
                VerticalOptions="Center">
                <!--  Desktop: alterna a barra lateral fixa  -->
                <ImageButton
                    Clicked="OnToggleThumbnailsClicked"
                    IsVisible="{OnIdiom Default=False,
                                        Desktop=True}"
                    Style="{StaticResource IconBtn}">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="{x:Static local:Icons.FontFamily}"
                            Glyph="{x:Static local:Icons.Thumbnails}"
                            Size="22"
                            Color="{StaticResource IconLight}" />
                    </ImageButton.Source>
                </ImageButton>
            </HorizontalStackLayout>

            <!--
                Mobile (Android/iOS): abre/fecha o drawer sobreposto. A COLUNA (0=esq / 2=dir) e o
                alinhamento seguem ThumbnailBarPlacement — definidos em code-behind. IsVisible também
                (visível só no mobile e quando EnableThumbnailBar=true).
            -->
            <ImageButton
                x:Name="ThumbDrawerBtn"
                Grid.Column="2"
                Clicked="OnOpenThumbDrawerClicked"
                HorizontalOptions="End"
                IsVisible="False"
                Style="{StaticResource IconBtn}"
                VerticalOptions="Center">
                <ImageButton.Source>
                    <FontImageSource
                        FontFamily="{x:Static local:Icons.FontFamily}"
                        Glyph="{x:Static local:Icons.Thumbnails}"
                        Size="22"
                        Color="{StaticResource IconLight}" />
                </ImageButton.Source>
            </ImageButton>

            <!--  Centro: zoom + página  -->
            <HorizontalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                Spacing="4"
                VerticalOptions="Center">

                <ImageButton Clicked="OnZoomOutClicked" Style="{StaticResource ToolBtn}">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="{x:Static local:Icons.FontFamily}"
                            Glyph="{x:Static local:Icons.ZoomOut}"
                            Size="22"
                            Color="{StaticResource IconLight}" />
                    </ImageButton.Source>
                </ImageButton>

                <Label
                    x:Name="ZoomLabel"
                    FontSize="12.5"
                    HorizontalTextAlignment="Center"
                    MinimumWidthRequest="46"
                    Text="100%"
                    TextColor="{StaticResource OnSurfaceLight}"
                    VerticalOptions="Center" />

                <ImageButton Clicked="OnZoomInClicked" Style="{StaticResource ToolBtn}">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="{x:Static local:Icons.FontFamily}"
                            Glyph="{x:Static local:Icons.ZoomIn}"
                            Size="22"
                            Color="{StaticResource IconLight}" />
                    </ImageButton.Source>
                </ImageButton>

                <BoxView
                    Margin="8,0"
                    HeightRequest="22"
                    VerticalOptions="Center"
                    WidthRequest="1"
                    Color="{StaticResource OutlineLight}" />

                <ImageButton
                    x:Name="PrevButton"
                    Clicked="OnPrevClicked"
                    IsEnabled="False"
                    Style="{StaticResource NavBtn}">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="{x:Static local:Icons.FontFamily}"
                            Glyph="{x:Static local:Icons.Prev}"
                            Size="22"
                            Color="{StaticResource IconLight}" />
                    </ImageButton.Source>
                </ImageButton>

                <Label
                    x:Name="PageLabel"
                    FontAttributes="Bold"
                    FontSize="12.5"
                    HorizontalTextAlignment="Center"
                    MinimumWidthRequest="60"
                    Text="—"
                    TextColor="{StaticResource OnSurfaceLight}"
                    VerticalOptions="Center" />

                <ImageButton
                    x:Name="NextButton"
                    Clicked="OnNextClicked"
                    IsEnabled="False"
                    Style="{StaticResource NavBtn}">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="{x:Static local:Icons.FontFamily}"
                            Glyph="{x:Static local:Icons.Next}"
                            Size="22"
                            Color="{StaticResource IconLight}" />
                    </ImageButton.Source>
                </ImageButton>

            </HorizontalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
