<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="sample.ReaderDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pdf="clr-namespace:Agile.Maui;assembly=Agile.Maui.Pdf"
    Title="PDF Viewer"
    BackgroundColor="{StaticResource BackdropLight}"
    Shell.NavBarIsVisible="False">

    <!--
        Demonstra o componente PRONTO: basta um PdfReaderView (toolbar + busca + barra inferior
        já inclusos). As propriedades abaixo são os defaults, explicitadas como exemplo de
        configuração. Compare com PdfViewerPage, que monta a UI à mão sobre o PdfViewer base.
    -->
    <pdf:PdfReaderView
        x:Name="Reader"
        CopiedMessageText="Copied"
        CopyButtonText="Copy"
        FullscreenTogglePlacement="Bottom"
        LoadFailedText="Failed to load"
        LoadingText="Loading…"
        MaxZoom="3"
        MinZoom="1"
        NavigationButtonMode="Auto"
        PageCountFormat="{}{0} pages"
        PrintJobName="Document"
        ScrollOrientation="Vertical"
        SearchPlaceholder="Search…"
        ShowBottomBar="True"
        ShowFullscreenToggle="True"
        ShowOrientationToggle="True"
        ShowPrint="True"
        ShowSearch="True"
        ShowShare="True"
        ShowToolbar="True"
        Source="InteligenciaArtificial.pdf"
        ThumbnailBarPlacement="{OnPlatform Android=Right,
                                           iOS=Right,
                                           MacCatalyst=Left,
                                           WinUI=Left}"
        ThumbnailBarTitleText="Pages" />

</ContentPage>
