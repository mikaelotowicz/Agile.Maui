<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="sample.ReaderDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pdf="clr-namespace:Agile.Maui;assembly=Agile.Maui.Pdf"
    Title="PDF (pronto)"
    Shell.NavBarIsVisible="False">

    <!--
        Demonstra o componente PRONTO: basta um PdfReaderView (toolbar + busca + barra inferior
        já inclusos). As propriedades abaixo são os defaults, explicitadas como exemplo de
        configuração. Compare com PdfViewerPage, que monta a UI à mão sobre o PdfViewer base.
    -->
    <pdf:PdfReaderView
        x:Name="Reader"
        CopiedMessageText="Copiado"
        CopyButtonText="Copiar"
        LoadFailedText="Falha ao carregar"
        LoadingText="Carregando…"
        MaxZoom="3"
        MinZoom="1"
        PageCountFormat="{}{0} páginas"
        PrintJobName="Documento"
        ScrollOrientation="Vertical"
        SearchPlaceholder="Buscar…"
        ShowBottomBar="True"
        ShowOrientationToggle="True"
        ShowPrint="True"
        ShowSearch="True"
        ShowShare="True"
        ShowToolbar="True"
        Source="InteligenciaArtificial.pdf"
        ThumbnailBarPlacement="Right"
        ThumbnailBarTitleText="Páginas" />

</ContentPage>
