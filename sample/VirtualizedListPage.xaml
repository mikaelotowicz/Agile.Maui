<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="sample.VirtualizedListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Agile.Maui;assembly=Agile.Maui"
    xmlns:local="clr-namespace:sample"
    Title="Lista Virtualizada"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackdropLight},
                                      Dark={StaticResource BackdropDark}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0">

        <!--  ── Barra de controles ───────────────────────────────────────  -->
        <Border
            Grid.Row="0"
            Padding="12,10"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight},
                                              Dark={StaticResource SurfaceAltDark}}"
            Stroke="Transparent">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                <!--  Contagem de itens  -->
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="1"
                    VerticalOptions="Center">
                    <Label
                        x:Name="ItemCountLabel"
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="0 produtos"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                    Dark={StaticResource Gray100}}" />
                    <Label
                        x:Name="ScrollLabel"
                        FontSize="11"
                        Text="Posição: 0"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                    Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <!--  Botão Colunas  -->
                <Button
                    x:Name="ColumnToggleButton"
                    Grid.Column="1"
                    Padding="10,0"
                    BackgroundColor="{StaticResource Accent}"
                    Clicked="OnColumnToggleClicked"
                    CornerRadius="8"
                    FontSize="13"
                    HeightRequest="38"
                    Text="⊞ Grade"
                    TextColor="White" />

                <!--  Botão Altura Fixa  -->
                <Button
                    x:Name="HeightToggleButton"
                    Grid.Column="2"
                    Padding="10,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200},
                                                      Dark={StaticResource Gray600}}"
                    Clicked="OnHeightToggleClicked"
                    CornerRadius="8"
                    FontSize="13"
                    HeightRequest="38"
                    Text="↕ Fixo"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                Dark={StaticResource Gray100}}" />
            </Grid>
        </Border>

        <!--  ── Barra de busca ───────────────────────────────────────────  -->
        <SearchBar
            x:Name="SearchBar"
            Grid.Row="1"
            Margin="8,6"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
            Placeholder="Buscar produto..."
            TextChanged="OnSearchTextChanged" />

        <!--  ── Lista virtualizada ──────────────────────────────────────  -->
        <controls:VirtualizedCollectionView
            x:Name="ProductList"
            Grid.Row="2"
            ItemHeightRequest="200"
            ItemSizingStrategy="MeasureAllItems"
            ItemsSource="{Binding Items}"
            RemainingItemsThreshold="8"
            RemainingItemsThresholdReached="OnLoadMore"
            Scrolled="OnScrolled">

            <controls:VirtualizedCollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ProductItem">
                    <Border
                        Margin="8,4"
                        Padding="12,10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                                          Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource OutlineLight},
                                                 Dark={StaticResource OutlineDark}}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="8">

                            <!--  Linha principal do produto  -->
                            <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                    HeightRequest="76"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="76">
                                    <controls:ImageView
                                        AspectMode="CenterCrop"
                                        EnableFullscreen="True"
                                        FullscreenSource="{Binding FullImageUrl}"
                                        HeightRequest="76"
                                        IsUrl="True"
                                        Source="{Binding ImageUrl}"
                                        WidthRequest="76" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Name}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                    Dark={StaticResource Gray100}}" />
                                    <Label
                                        FontAttributes="Italic"
                                        FontSize="12"
                                        Text="{Binding Category}"
                                        TextColor="{StaticResource Accent}" />
                                    <Label
                                        FontSize="12"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Description}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                    Dark={StaticResource Gray400}}" />
                                    <HorizontalStackLayout Margin="0,4,0,0" Spacing="12">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding PriceText}"
                                            TextColor="{StaticResource Accent}" />
                                        <Label
                                            FontSize="13"
                                            Text="{Binding RatingText}"
                                            TextColor="{StaticResource Warning}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <!--  Expander #1 — Especificações  -->
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Especificações"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                Dark={StaticResource Gray100}}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding SpecsChevron}"
                                    TextColor="{StaticResource Accent}"
                                    VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSpecsTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <VerticalStackLayout
                                Padding="4,0,0,4"
                                IsVisible="{Binding IsExpandedSpecs}"
                                Spacing="2">
                                <Label FontSize="12" Text="{Binding SpecWeight, StringFormat='Peso: {0}'}" />
                                <Label FontSize="12" Text="{Binding SpecDimensions, StringFormat='Dimensões: {0}'}" />
                                <Label FontSize="12" Text="{Binding SpecMaterial, StringFormat='Material: {0}'}" />
                                <Label FontSize="12" Text="{Binding SpecWarranty, StringFormat='Garantia: {0}'}" />
                                <Label FontSize="12" Text="{Binding SpecOrigin, StringFormat='Origem: {0}'}" />
                            </VerticalStackLayout>

                            <!--  Expander #2 — Avaliações  -->
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Avaliações"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                Dark={StaticResource Gray100}}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding ReviewsChevron}"
                                    TextColor="{StaticResource Accent}"
                                    VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnReviewsTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <VerticalStackLayout
                                Padding="4,0,0,4"
                                IsVisible="{Binding IsExpandedReviews}"
                                Spacing="6">
                                <VerticalStackLayout Spacing="1">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding Review1Author}" />
                                    <Label
                                        FontSize="11"
                                        Text="{Binding Review1Stars}"
                                        TextColor="{StaticResource Warning}" />
                                    <Label FontSize="11" Text="{Binding Review1Text}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="1">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding Review2Author}" />
                                    <Label
                                        FontSize="11"
                                        Text="{Binding Review2Stars}"
                                        TextColor="{StaticResource Warning}" />
                                    <Label FontSize="11" Text="{Binding Review2Text}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="1">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding Review3Author}" />
                                    <Label
                                        FontSize="11"
                                        Text="{Binding Review3Stars}"
                                        TextColor="{StaticResource Warning}" />
                                    <Label FontSize="11" Text="{Binding Review3Text}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </controls:VirtualizedCollectionView.ItemTemplate>

        </controls:VirtualizedCollectionView>

        <!--  ── Métricas de performance ────────────────────────────────  -->
        <Border
            Grid.Row="3"
            Padding="12,8"
            BackgroundColor="{AppThemeBinding Light={StaticResource SuccessContainerLight},
                                              Dark={StaticResource SuccessContainerDark}}"
            Stroke="Transparent">
            <Grid
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto"
                RowSpacing="2">
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="11"
                    Text="VirtualizedCollectionView · Performance"
                    TextColor="{AppThemeBinding Light=#2E7D32,
                                                Dark=#A5D6A7}" />
                <Label
                    x:Name="FpsLabel"
                    Grid.Row="0"
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="—"
                    TextColor="{AppThemeBinding Light=#2E7D32,
                                                Dark=#A5D6A7}" />
                <Label
                    x:Name="MetricsLabel"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    FontSize="11"
                    Text="Aguardando primeiro scroll..."
                    TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                Dark={StaticResource Gray400}}" />
            </Grid>
        </Border>

        <!--  ── Rodapé: loading / status ───────────────────────────────  -->
        <Grid
            Grid.Row="4"
            Padding="12,6"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight},
                                              Dark={StaticResource SurfaceAltDark}}"
            ColumnDefinitions="*,Auto">
            <Label
                x:Name="StatusLabel"
                Grid.Column="0"
                FontSize="12"
                Text="Pronto"
                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                            Dark={StaticResource Gray400}}"
                VerticalOptions="Center" />
            <ActivityIndicator
                x:Name="LoadingIndicator"
                Grid.Column="1"
                HeightRequest="22"
                IsRunning="False"
                IsVisible="False"
                WidthRequest="22"
                Color="{StaticResource Accent}" />
        </Grid>

    </Grid>
</ContentPage>
