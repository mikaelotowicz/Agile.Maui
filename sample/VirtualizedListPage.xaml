<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="sample.VirtualizedListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gallery="clr-namespace:Agile.Maui;assembly=Agile.Maui.Gallery"
    xmlns:local="clr-namespace:sample"
    xmlns:virtualized="clr-namespace:Agile.Maui;assembly=Agile.Maui.VirtualizedCollection"
    Title="Virtualized Collection"
    BackgroundColor="{StaticResource BackdropLight}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0">

        <Border
            Grid.Row="0"
            Padding="12,10"
            BackgroundColor="{StaticResource SurfaceAltLight}"
            Stroke="Transparent">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="1"
                    VerticalOptions="Center">
                    <Label
                        x:Name="ItemCountLabel"
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="0 products"
                        TextColor="{StaticResource OnSurfaceLight}" />
                    <Label
                        x:Name="ScrollLabel"
                        FontSize="11"
                        Text="Position: 0"
                        TextColor="{StaticResource OnSurfaceVariantLight}" />
                </VerticalStackLayout>

                <Button
                    x:Name="ColumnToggleButton"
                    Grid.Column="1"
                    Padding="10,0"
                    BackgroundColor="{StaticResource Accent}"
                    Clicked="OnColumnToggleClicked"
                    CornerRadius="8"
                    FontSize="13"
                    HeightRequest="38"
                    Text="Grid"
                    TextColor="White" />

                <Button
                    x:Name="HeightToggleButton"
                    Grid.Column="2"
                    Padding="10,0"
                    BackgroundColor="{StaticResource Gray200}"
                    Clicked="OnHeightToggleClicked"
                    CornerRadius="8"
                    FontSize="13"
                    HeightRequest="38"
                    Text="Fixed"
                    TextColor="{StaticResource OnSurfaceLight}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="8,6"
            Padding="12,0"
            BackgroundColor="{StaticResource SurfaceLight}"
            Stroke="{StaticResource OutlineLight}"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label
                    Grid.Column="0"
                    FontFamily="{x:Static local:Icons.FontFamily}"
                    FontSize="20"
                    Text="{x:Static local:Icons.Search}"
                    TextColor="{StaticResource OnSurfaceLight}"
                    VerticalOptions="Center" />

                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    Placeholder="Search products..."
                    PlaceholderColor="{StaticResource OnSurfaceVariantLight}"
                    TextChanged="OnSearchTextChanged"
                    TextColor="{StaticResource OnSurfaceLight}" />
            </Grid>
        </Border>

        <virtualized:VirtualizedCollectionView
            x:Name="ProductList"
            Grid.Row="2"
            ItemHeightRequest="200"
            ItemSizingStrategy="Dynamic"
            ItemsSource="{Binding Items}"
            RemainingItemsThreshold="8"
            RemainingItemsThresholdReached="OnLoadMore"
            Scrolled="OnScrolled">

            <virtualized:VirtualizedCollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ProductItem">
                    <Border
                        Margin="8,4"
                        Padding="12,10"
                        BackgroundColor="{StaticResource SurfaceLight}"
                        Stroke="{StaticResource OutlineLight}"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{StaticResource SurfaceAltLight}"
                                    HeightRequest="76"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="76">
                                    <gallery:ImageView
                                        AspectMode="CenterCrop"
                                        EnableFullscreen="True"
                                        FullscreenSource="{Binding FullImageUrl}"
                                        HeightRequest="76"
                                        IsUrl="True"
                                        Source="{Binding ImageUrl}"
                                        WidthRequest="76" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Name}"
                                        TextColor="{StaticResource OnSurfaceLight}" />
                                    <Label
                                        FontAttributes="Italic"
                                        FontSize="12"
                                        Text="{Binding Category}"
                                        TextColor="{StaticResource Accent}" />
                                    <Label
                                        FontSize="12"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Description}"
                                        TextColor="{StaticResource OnSurfaceVariantLight}" />
                                    <HorizontalStackLayout Margin="0,4,0,0" Spacing="12">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding PriceText}"
                                            TextColor="{StaticResource Accent}" />
                                        <Label
                                            FontSize="13"
                                            Text="{Binding RatingText}"
                                            TextColor="{StaticResource Warning}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource OutlineLight}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Specifications"
                                    TextColor="{StaticResource OnSurfaceLight}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding SpecsChevron}"
                                    TextColor="{StaticResource Accent}"
                                    VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSpecsTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <VerticalStackLayout
                                Padding="4,0,0,4"
                                IsVisible="{Binding IsExpandedSpecs}"
                                Spacing="2">
                                <Label FontSize="12" Text="{Binding SpecWeight, StringFormat='Weight: {0}'}" />
                                <Label FontSize="12" Text="{Binding SpecDimensions, StringFormat='Dimensions: {0}'}" />
                                <Label FontSize="12" Text="{Binding SpecMaterial, StringFormat='Material: {0}'}" />
                                <Label FontSize="12" Text="{Binding SpecWarranty, StringFormat='Warranty: {0}'}" />
                                <Label FontSize="12" Text="{Binding SpecOrigin, StringFormat='Origin: {0}'}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{StaticResource OutlineLight}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Reviews"
                                    TextColor="{StaticResource OnSurfaceLight}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding ReviewsChevron}"
                                    TextColor="{StaticResource Accent}"
                                    VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnReviewsTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <VerticalStackLayout
                                Padding="4,0,0,4"
                                IsVisible="{Binding IsExpandedReviews}"
                                Spacing="6">
                                <VerticalStackLayout Spacing="1">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding Review1Author}" />
                                    <Label
                                        FontSize="11"
                                        Text="{Binding Review1Stars}"
                                        TextColor="{StaticResource Warning}" />
                                    <Label FontSize="11" Text="{Binding Review1Text}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="1">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding Review2Author}" />
                                    <Label
                                        FontSize="11"
                                        Text="{Binding Review2Stars}"
                                        TextColor="{StaticResource Warning}" />
                                    <Label FontSize="11" Text="{Binding Review2Text}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="1">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding Review3Author}" />
                                    <Label
                                        FontSize="11"
                                        Text="{Binding Review3Stars}"
                                        TextColor="{StaticResource Warning}" />
                                    <Label FontSize="11" Text="{Binding Review3Text}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </virtualized:VirtualizedCollectionView.ItemTemplate>

        </virtualized:VirtualizedCollectionView>

        <Border
            Grid.Row="3"
            Padding="12,8"
            BackgroundColor="{StaticResource SuccessContainerLight}"
            Stroke="Transparent">
            <Grid
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto"
                RowSpacing="2">
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="11"
                    Text="VirtualizedCollectionView · Performance"
                    TextColor="#2E7D32" />
                <Label
                    x:Name="FpsLabel"
                    Grid.Row="0"
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="-"
                    TextColor="#2E7D32" />
                <Label
                    x:Name="MetricsLabel"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    FontSize="11"
                    Text="Waiting for the first scroll..."
                    TextColor="{StaticResource OnSurfaceVariantLight}" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="4"
            Padding="12,6"
            BackgroundColor="{StaticResource SurfaceAltLight}"
            ColumnDefinitions="*,Auto">
            <Label
                x:Name="StatusLabel"
                Grid.Column="0"
                FontSize="12"
                Text="Ready"
                TextColor="{StaticResource OnSurfaceVariantLight}"
                VerticalOptions="Center" />
            <ActivityIndicator
                x:Name="LoadingIndicator"
                Grid.Column="1"
                HeightRequest="22"
                IsRunning="False"
                IsVisible="False"
                WidthRequest="22"
                Color="{StaticResource Accent}" />
        </Grid>

    </Grid>
</ContentPage>
