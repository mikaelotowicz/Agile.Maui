<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Agile.Maui.Gallery</AssemblyName>
		<RootNamespace>Agile.Maui</RootNamespace>
		<PackageId>Agile.Maui.Gallery</PackageId>
		<AgilePackageChannel Condition="'$(AgilePackageChannel)' == ''">Preview</AgilePackageChannel>
		<Version Condition="'$(AgilePackageChannel)' == 'Stable'">1.2.0</Version>
		<Version Condition="'$(AgilePackageChannel)' != 'Stable'">1.2.0-preview.1</Version>
		<Authors>Micael Otowicz</Authors>
		<Product>Agile.Maui.Gallery</Product>
		<Copyright>Copyright © 2026 Micael Otowicz</Copyright>
		<RepositoryUrl>https://github.com/mikaelotowicz/agile.maui</RepositoryUrl>
		<PackageProjectUrl>https://github.com/mikaelotowicz/agile.maui</PackageProjectUrl>
		<Description>MAUI component library providing ImageView (zoom + fullscreen) and GalleryView for Android, iOS, macOS Catalyst, and Windows.</Description>
		<PackageTags>maui;android;ios;maccatalyst;windows;image;gallery;zoom</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- TFM neutro (net10.0/net11.0): só o código cross-platform — usado pelos testes de host. -->
		<TargetFrameworks>net10.0;net11.0;net10.0-android;net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net11.0-ios;net10.0-maccatalyst;net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0;net11.0-windows10.0.26100.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- XML docs no pacote (IntelliSense); CS1591 suprimido para não exigir doc em todo membro público. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<NeutralLanguage>pt-BR</NeutralLanguage>
		<Title>Agile.Maui.Gallery</Title>
		<PackageReleaseNotes>1.2.0: suporte ao .NET 11 no canal estável: TFMs net11.0, net11.0-android, net11.0-ios, net11.0-maccatalyst e net11.0-windows10.0.26100.0 ao lado dos net10.0, com Microsoft.Maui.Controls 11.0.0. trocar as imagens com a mesma quantidade (por exemplo, a miniatura pelo original) mantém as páginas e a posição e troca só a fonte das que mudaram, sem a foto piscar. Android: a página é rebindada no mesmo ViewHolder e a foto anterior segura a página até a nova decodificar. iOS/Mac Catalyst: a posição atual é mantida (antes voltava para a primeira) e o placeholder não cobre a foto atual durante a carga. Quantidade diferente, ou outra propriedade mudando, continua recriando a galeria; no Windows a galeria ainda é recriada. 1.1.0: GalleryView.VerticalImageAlignment (Start/Center/End) posiciona a foto com AspectFit no Android, iOS e Mac Catalyst. Correções: páginas da galeria Android ocupam a área inteira; GalleryView no iOS/Mac ocupa a altura oferecida, como no Android (com MinimumHeightRequest/MaximumHeightRequest e sem HeightRequest, ficava no mínimo e a foto com AspectFit ganhava faixa dos lados); pinch sem crash em foto menor que a tela; proporção preservada no decode do Windows (só DecodePixelWidth); fim do loop de ImageFailed com placeholder inválido; rotação re-ancora o zoom e a página; decode do fullscreen proporcional à tela (teto de 4096 px) e, no iOS/Mac, fora da main thread; cache Apple limitado a 96 MB. Microsoft.Maui.Controls 10.0.90 e XML docs no pacote. iOS/Mac Catalyst: os fullscreens (zoom e galeria) mostram a foto em vez do placeholder — a escala da tela era lida fora da main thread após o download e falhava em Debug.</PackageReleaseNotes>
		<PackageIcon>agile.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Agile.Maui.Gallery.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\agile.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
	</ItemGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.0'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0" />
	</ItemGroup>

	<!-- Dependências Android usadas diretamente pelos handlers (Glide e DialogFragment). Referências
	     explícitas para não depender só do grafo transitivo do MAUI; mesmas versões que cada
	     linha do MAUI resolve (net10 → MAUI 10.0.90; net11 → MAUI 11.0.0), senão NU1605. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and $([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0'))">
		<PackageReference Include="Xamarin.Android.Glide" Version="4.16.0.14" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.8.1" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and $([System.String]::Copy('$(TargetFramework)').StartsWith('net11.0'))">
		<PackageReference Include="Xamarin.Android.Glide" Version="5.0.7.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.9.3" />
	</ItemGroup>

</Project>
