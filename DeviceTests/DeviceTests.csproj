<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Device tests: só Android (emulador/dispositivo) e Windows local.
		     iOS/MacCatalyst exigem um Mac e ficam fora do escopo deste projeto. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<AssemblyName>Agile.Maui.DeviceTests</AssemblyName>
		<RootNamespace>Agile.Maui.DeviceTests</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>

		<ApplicationTitle>Agile DeviceTests</ApplicationTitle>
		<ApplicationId>com.agile.maui.devicetests</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Windows roda unpackaged: `run-windows.ps1` inicia o .exe direto do bin. -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<!-- Fonte TTF real (da sample) empacotada como asset bruto: usada pelo teste de
		     PdfGen com fonte embutida (EmbeddedFont.Load) num device real. -->
		<MauiAsset Include="..\sample\Resources\Fonts\OpenSans-Regular.ttf" LogicalName="OpenSans-Regular.ttf" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<!-- Só os asserts do xunit: runners de terceiros são frágeis em net10 — o harness
		     de discovery/execução é próprio (TestRunner/). -->
		<PackageReference Include="xunit.assert" Version="2.9.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ChipGroup\ChipGroup.csproj" />
		<ProjectReference Include="..\GalleryView\GalleryView.csproj" />
		<ProjectReference Include="..\PDFViewer\PDFViewer.csproj" />
		<ProjectReference Include="..\PdfGen\PdfGen.csproj" />
		<ProjectReference Include="..\SignaturePad\SignaturePad.csproj" />
		<ProjectReference Include="..\VirtualizedCollectionView\VirtualizedCollectionView.csproj" />
	</ItemGroup>

</Project>
