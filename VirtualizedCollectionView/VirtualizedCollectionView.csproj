<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Agile.Maui.VirtualizedCollection</AssemblyName>
		<RootNamespace>Agile.Maui</RootNamespace>
		<PackageId>Agile.Maui.VirtualizedCollection</PackageId>
		<AgilePackageChannel Condition="'$(AgilePackageChannel)' == ''">Preview</AgilePackageChannel>
		<Version Condition="'$(AgilePackageChannel)' == 'Stable'">1.0.4</Version>
		<Version Condition="'$(AgilePackageChannel)' != 'Stable'">1.0.4-preview.1</Version>
		<Authors>Micael Otowicz</Authors>
		<Product>Agile.Maui.VirtualizedCollection</Product>
		<Copyright>Copyright © 2026 Micael Otowicz</Copyright>
		<RepositoryUrl>https://github.com/mikaelotowicz/agile.maui</RepositoryUrl>
		<PackageProjectUrl>https://github.com/mikaelotowicz/agile.maui</PackageProjectUrl>
		<Description>MAUI component library providing VirtualizedCollectionView for Android, iOS, macOS Catalyst, and Windows.</Description>
		<PackageTags>maui;android;ios;maccatalyst;windows;collection;virtualized;list</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<NeutralLanguage>pt-BR</NeutralLanguage>
		<Title>Agile.Maui.VirtualizedCollection</Title>
		<PackageReleaseNotes>1.0.4: correções de memória e teardown no Android (holders sob referência fraca), self-sizing estável no iOS e Header preservado na reciclagem.</PackageReleaseNotes>
		<!-- TFM neutro (net10.0/net11.0): só o código cross-platform — usado pelos testes de host. -->
		<TargetFrameworks Condition="'$(AgilePackageChannel)' == 'Stable'">net10.0;net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' == 'Stable' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' == 'Stable' and $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' != 'Stable'">net10.0;net11.0;net10.0-android;net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' != 'Stable' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net11.0-ios;net10.0-maccatalyst;net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' != 'Stable' and $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0;net11.0-windows10.0.26100.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- XML docs no pacote (IntelliSense); CS1591 suprimido para não exigir doc em todo membro público. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<PackageIcon>agile.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
	</ItemGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.0'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-preview.7.26406.9" />
	</ItemGroup>

	<!-- Só para depuração do sample: não embarcar o atributo nos assemblies publicados. -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<InternalsVisibleTo Include="sample" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Agile.Maui.VirtualizedCollection.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\agile.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
