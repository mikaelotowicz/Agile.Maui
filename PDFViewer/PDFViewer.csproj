<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Agile.Maui.Pdf</AssemblyName>
		<RootNamespace>Agile.Maui</RootNamespace>
		<PackageId>Agile.Maui.Pdf</PackageId>
		<Version>1.0.2</Version>
		<Authors>Micael Otowicz</Authors>
		<Product>Agile.Maui.Pdf</Product>
		<Copyright>Copyright © 2026 Micael Otowicz</Copyright>
		<RepositoryUrl>https://github.com/mikaelotowicz/agile.maui</RepositoryUrl>
		<PackageProjectUrl>https://github.com/mikaelotowicz/agile.maui</PackageProjectUrl>
		<Description>MAUI component library providing PdfViewer for Android, iOS, macOS Catalyst, and Windows.</Description>
		<PackageTags>maui;android;ios;maccatalyst;windows;pdf;viewer</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<NeutralLanguage>pt-BR</NeutralLanguage>
		<Title>Agile.Maui.Pdf</Title>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.26100.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<PackageIcon>agile.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
	</ItemGroup>

	<!-- Fonte de ícones do PdfReaderView (Material Design Icons), empacotada e registrada por UseAgilePdfViewer(). -->
	<ItemGroup>
		<MauiFont Include="Resources\Fonts\AgilePdfIcons.ttf" />
	</ItemGroup>

	<!-- Motor de rasterização + camada de texto PDF no Windows: PDFium (mesmo do Edge/Chrome) via
	     PDFiumCore (binding P/Invoke de baixo nível, binários nativos inclusos). Acesso direto à
	     API de texto (FPDFText_*) para seleção/busca, e ao documento persistente (sem reabrir). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="PDFiumCore" Version="151.0.7891" />
	</ItemGroup>

	<!-- Android: PDFium só para a CAMADA DE TEXTO (seleção/busca). O render continua via
	     PdfRenderer nativo. Binding PDFiumCore + binário nativo bblanchon.PDFium.Android. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="PDFiumCore" Version="151.0.7891" />
		<PackageReference Include="bblanchon.PDFium.Android" Version="151.0.7891" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="sample" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\agile.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
