<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Agile.Maui.Pdf</AssemblyName>
		<RootNamespace>Agile.Maui</RootNamespace>
		<PackageId>Agile.Maui.Pdf</PackageId>
		<AgilePackageChannel Condition="'$(AgilePackageChannel)' == ''">Preview</AgilePackageChannel>
		<Version Condition="'$(AgilePackageChannel)' == 'Stable'">1.0.4</Version>
		<Version Condition="'$(AgilePackageChannel)' != 'Stable'">1.0.4-preview.1</Version>
		<Authors>Micael Otowicz</Authors>
		<Product>Agile.Maui.Pdf</Product>
		<Copyright>Copyright © 2026 Micael Otowicz</Copyright>
		<RepositoryUrl>https://github.com/mikaelotowicz/agile.maui</RepositoryUrl>
		<PackageProjectUrl>https://github.com/mikaelotowicz/agile.maui</PackageProjectUrl>
		<Description>MAUI component library providing PdfViewer for Android, iOS, macOS Catalyst, and Windows.</Description>
		<PackageTags>maui;android;ios;maccatalyst;windows;pdf;viewer</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<NeutralLanguage>pt-BR</NeutralLanguage>
		<Title>Agile.Maui.Pdf</Title>
		<PackageReleaseNotes>1.0.4: pan vertical e horizontal quando ampliado no Android, PDFium 153 com binding e binário nativo alinhados e correções de robustez no render e no share.</PackageReleaseNotes>
		<!-- TFM neutro (net10.0/net11.0): só o código cross-platform — usado pelos testes de host. -->
		<TargetFrameworks Condition="'$(AgilePackageChannel)' == 'Stable'">net10.0;net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' == 'Stable' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' == 'Stable' and $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' != 'Stable'">net10.0;net11.0;net10.0-android;net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' != 'Stable' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net11.0-ios;net10.0-maccatalyst;net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="'$(AgilePackageChannel)' != 'Stable' and $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0;net11.0-windows10.0.26100.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- XML docs no pacote (IntelliSense); CS1591 suprimido para não exigir doc em todo membro público. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<PackageIcon>agile.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
	</ItemGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.0'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-preview.7.26406.9" />
	</ItemGroup>

	<!-- Fonte de ícones do PdfReaderView (Material Design Icons), registrada por UseAgilePdfViewer().
	     MauiFont numa biblioteca só chega ao app via ProjectReference: o .ttf não ia para o .nupkg e quem
	     instalava pelo NuGet ficava com os ícones em branco. O pacote leva o .ttf e um .targets em
	     buildTransitive que declara o mesmo MauiFont no app consumidor. (Fonte embutida no assembly
	     não serve: o MAUI não a carrega em app Windows unpackaged.) -->
	<ItemGroup>
		<MauiFont Include="Resources\Fonts\AgilePdfIcons.ttf" />
		<None Remove="Resources\Fonts\AgilePdfIcons.ttf;buildTransitive\Agile.Maui.Pdf.targets" />
		<None Include="Resources\Fonts\AgilePdfIcons.ttf" Pack="true" PackagePath="buildTransitive\Fonts\" Visible="false" />
		<None Include="buildTransitive\Agile.Maui.Pdf.targets" Pack="true" PackagePath="buildTransitive\" />
	</ItemGroup>

	<!-- Motor de rasterização + camada de texto PDF no Windows: PDFium (mesmo do Edge/Chrome) via
	     PDFiumCore (binding P/Invoke de baixo nível, binários nativos inclusos). Acesso direto à
	     API de texto (FPDFText_*) para seleção/busca, e ao documento persistente (sem reabrir). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="PDFiumCore" Version="153.0.7999" />
	</ItemGroup>

	<!-- Android: PDFium só para a CAMADA DE TEXTO (seleção/busca). O render continua via
	     PdfRenderer nativo. Binding PDFiumCore + binário nativo bblanchon.PDFium.Android. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="PDFiumCore" Version="153.0.7999" />
		<!-- Mesmo build do binding PDFiumCore: binding e binário nativo precisam casar. -->
		<PackageReference Include="bblanchon.PDFium.Android" Version="153.0.7999" />
	</ItemGroup>

	<!-- Só para depuração do sample: não embarcar o atributo nos assemblies publicados. -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<InternalsVisibleTo Include="sample" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Agile.Maui.Pdf.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\agile.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
