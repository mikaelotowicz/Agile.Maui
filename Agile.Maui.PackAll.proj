<Project>

	<PropertyGroup>
		<Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
		<PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildThisFileDirectory)nupkgs</PackageOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackProject Include="ChipGroup\ChipGroup.csproj" />
		<PackProject Include="GalleryView\GalleryView.csproj" />
		<PackProject Include="PDFViewer\PDFViewer.csproj" />
		<PackProject Include="PdfGen\PdfGen.csproj" />
		<PackProject Include="SignaturePad\SignaturePad.csproj" />
		<PackProject Include="VirtualizedCollectionView\VirtualizedCollectionView.csproj" />
	</ItemGroup>

	<!-- Cada csproj define a própria versão (Stable/Preview via AgilePackageChannel); o PackAll
	     não sobrescreve Version/PackageVersion para não achatar versões distintas (ex.: PdfGen). -->

	<!-- Só o Windows produz todos os TFMs (android + ios/maccatalyst + windows); empacotar em outro
	     SO geraria pacotes incompletos com o mesmo número de versão. -->
	<Target Name="EnsureWindowsPack">
		<Error Condition="!$([MSBuild]::IsOSPlatform('windows'))"
			Text="Empacote no Windows: em outro SO os TFMs de iOS/MacCatalyst/Windows ficam de fora e o pacote sai incompleto com o mesmo número de versão." />
	</Target>

	<Target Name="PackStable" DependsOnTargets="EnsureWindowsPack">
		<MakeDir Directories="$(PackageOutputPath)" />
		<Exec Command='dotnet pack "%(PackProject.FullPath)" -c "$(Configuration)" -o "$(PackageOutputPath)" /p:AgilePackageChannel=Stable' />
	</Target>

	<Target Name="PackPreview" DependsOnTargets="EnsureWindowsPack">
		<MakeDir Directories="$(PackageOutputPath)" />
		<Exec Command='dotnet pack "%(PackProject.FullPath)" -c "$(Configuration)" -o "$(PackageOutputPath)" /p:AgilePackageChannel=Preview' />
	</Target>

	<Target Name="Pack" DependsOnTargets="PackStable;PackPreview">
	</Target>

</Project>
